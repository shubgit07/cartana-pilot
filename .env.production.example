# ==============================================================================
# Cartana Production Environment Variables (.env.production)
# Render test-deploy: DATABASE_URL = Neon pooled URL (?sslmode=require),
# REDIS_URL = Upstash TCP (rediss://...), STORAGE_DRIVER=local (ephemeral).
# NOTE: the API reads apps/api-py/.env, NOT this file. This template documents
# the cloud values; paste them into the Render dashboard environment panel.
# ==============================================================================

# Database (Neon Postgres — relational source of truth; pgvector extension
# installed for the Vector columns, but never queried by vector)
DATABASE_URL=postgresql://<user>:<password>@<neon-host>/cartana?sslmode=require

# Storage (local ephemeral on Render test instances — re-upload after restarts)
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage

# Redis: ARQ workers + embedding cache need the TCP URL (not REST)
REDIS_URL=rediss://default:<upstash-token>@<upstash-host>:6379

# Vector index (Qdrant Cloud — primary semantic retrieval)
QDRANT_URL=https://<cluster-id>.<region>.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION_NAME=cartana_chunks

# GitHub (public-repo Codebase Index; no scopes needed for public data)
GITHUB_TOKEN=your_github_token

# Embeddings (Cloudflare Workers AI BGE Base 768-dim)
EMBEDDING_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# LLM Providers (Multi-LLM Fallback Routing Chain)
LLM_PROVIDER=routing
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
CEREBRAS_API_KEY=your_cerebras_api_key

# Upstash Redis REST (Optional, for 24h Deduplication Cache)
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=/api
