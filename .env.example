# =========================================================
# Cartana - Environment variables
# Copy this file to `.env` and fill in the values marked TODO.
# =========================================================

# ----- App -----
NODE_ENV=development
LOG_LEVEL=info

# ----- API (NestJS) -----
API_PORT=4000
API_BASE_URL=http://localhost:4000

# ----- Web (Next.js) -----
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# ----- Database (Postgres + pgvector) -----
# TODO: Replace with your own DATABASE_URL once Postgres+pgvector is running.
# When you start the docker-compose stack, the default value below should work.
# Neon (pooled URL + ?sslmode=require) works as-is; only Prisma's ?schema= param is stripped.
DATABASE_URL=postgresql://cartana:cartana@localhost:5432/cartana

# ----- Redis -----
# REDIS_URL is the TCP URL used by ARQ workers and the embedding cache.
# Local docker-compose default below; Upstash: rediss://default:<token>@<host>:6379
# UPSTASH_* (REST) backs the 24h PR-audit deduplication cache.
REDIS_URL=redis://localhost:6379

# ----- Storage -----
# Local filesystem storage root for uploaded sources (Phase 1).
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage

# ----- Embedding provider -----
# DECIDED target: Cloudflare Workers AI @cf/baai/bge-base-en-v1.5 -> vector(768)
EMBEDDING_PROVIDER=cloudflare
EMBEDDING_MODEL=@cf/baai/bge-base-en-v1.5
EMBEDDING_DIM=768

# TODO: Provide Cloudflare credentials before running embedding jobs.
# If left empty, the system runs in stub mode (no real embeddings; Phase 1 chat will still work for UX but retrieval will be inert).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ----- Vector index (Qdrant Cloud) -----
# Primary semantic index for repository code chunks. Postgres stays the source
# of truth (files/chunks/verdicts); Qdrant holds {id, vector, payload} mirrors.
# If QDRANT_URL is empty, the app runs without vectors (keyword fallback).
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=cartana_chunks

# ----- GitHub (public-repo Codebase Index) -----
# Server-side token for api.github.com (public data only). Lifts the
# anonymous 60 req/hr limit to 5,000/hr. Create at GitHub → Settings →
# Developer settings → Personal access tokens (no scopes needed for public).
GITHUB_TOKEN=

# ----- LLM provider (generation) -----
# The system uses a swappable default behind the AIProvider interface.
# Options: stub | cloudflare | fireworks
# - stub: retrieval-only answers, heuristic extraction, heuristic coverage audit
# - cloudflare: Cloudflare Workers AI (needs CLOUDFLARE_ACCOUNT_ID + CLOUDFLARE_API_TOKEN)
# - fireworks: Fireworks AI (needs FIREWORKS_API_KEY) — recommended for Phase 3 audit
LLM_PROVIDER=stub
LLM_MODEL=stub
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CLOUDFLARE_LLM_MODEL=@cf/meta/llama-3.1-8b-instruct

# ----- Fireworks AI (Phase 3 — coverage audit LLM) -----
# Used by the audit engine to judge requirement coverage with real reasoning.
# Fireworks is OpenAI-compatible: https://api.fireworks.ai/inference/v1/chat/completions
# Sign up at https://fireworks.ai → Settings → API Keys.
# If left empty AND LLM_PROVIDER=stub, the audit runs in heuristic mode (keyword-overlap, low quality).
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p1-8b-instruct

# ----- Dev user (single-user local MVP) -----
# Implicit dev user id. Phase 1 has no login.
DEV_USER_ID=dev-user
DEV_USER_EMAIL=dev@cartana.local
DEV_USER_NAME=Local Dev