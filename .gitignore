hypothesis/

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Environment (secrets) ----
.env
.env.local
.env.*.local

# ---- IDEs / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- Local data ----
data/
storage/

# ---- Vercel / Docker ----
.vercel/
.docker-compose.override.yml

# ---- Certs ----
*.pem
*.key

# ---- Benchmark reports (generated) ----
apps/api-py/benchmark/reports/

# ---- Documentation - keep only README.md and AGENTS.md.
# Internal planning/roadmap docs (PROGRESS.md, docs/, B1/B2 plans) stay local.
# Exception: benchmark fixture specs are committed data, not documentation.
*.md
!README.md
!AGENTS.md
!apps/api-py/benchmark/fixtures/*.md

# ---- Prisma (legacy) ----
apps/api/prisma/migrations/dev.db*

# ---- Local-only brief docs (untracked, keep on disk) ----
*.docx
build_docx.py
