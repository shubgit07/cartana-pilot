*.egg-info/
.eggs/
.Python

# ---- Build outputs ----
.next/
dist/
build/
out/
coverage/
*.tsbuildinfo
.turbo/

# ---- Python caches & tooling ----
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
nox/
.htmlcov/
.coverage
