@@ -0,0 +1,9 @@
+import hashlib
+
+
+def hash_password(password: str) -> str:
+    return hashlib.sha256(password.encode()).hexdigest()
+
+
+def verify_password(password: str, digest: str) -> bool:
+    return hash_password(password) == digest
