+from fastapi import APIRouter, HTTPException
+from app.services.assignments import AssignmentService
+from app.services.notifications import deliver_assignment_alert
+
+router = APIRouter(prefix="/assignments", tags=["assignments"])
+
+
+@router.post("/{task_id}/assign")
+def assign_task(task_id: str, user_id: str):
+    assignment = AssignmentService.assign(task_id, user_id)
+    deliver_assignment_alert(task_id, user_id, "system")
+    return {"assignment": assignment}
+
+
+@router.patch("/{task_id}/status")
+def set_status(task_id: str, status: str):
+    if status not in ("todo", "in_progress", "done"):
+        raise HTTPException(400, "Invalid status")
+    return {"status": AssignmentService.set_status(task_id, status)}
