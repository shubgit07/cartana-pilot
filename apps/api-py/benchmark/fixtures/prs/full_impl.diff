@@ -0,0 +1,30 @@
+from fastapi import APIRouter, Depends, HTTPException
+from app.services.tasks import TaskService
+from app.core.auth import require_user
+
+router = APIRouter(prefix="/tasks", tags=["tasks"])
+
+
+@router.post("")
+def create_task(title: str, description: str = "", user: dict = Depends(require_user)):
+    task = TaskService.create(title, description)
+    return {"task": task}
+
+
+@router.get("")
+def list_tasks(user: dict = Depends(require_user)):
+    return {"tasks": TaskService.list_all()}
+
+
+@router.patch("/{task_id}")
+def update_task(task_id: str, title: str, description: str, user: dict = Depends(require_user)):
+    task = TaskService.update(task_id, title, description)
+    if task is None:
+        raise HTTPException(404, "Task not found")
+    return {"task": task}
+
+
+@router.delete("/{task_id}")
+def delete_task(task_id: str, user: dict = Depends(require_user)):
+    TaskService.delete(task_id)
+    return {"status": "ok"}
