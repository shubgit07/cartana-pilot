@@ -0,0 +1,15 @@
+import time
+from collections import defaultdict
+
+from fastapi import HTTPException, Request
+
+RATE_LIMIT = 10
+_hits: dict[str, list[float]] = defaultdict(list)
+
+
+async def rate_limit_middleware(request: Request, call_next):
+    if request.url.path.startswith("/auth"):
+        now = time.time()
+        _hits[request.client.host].append(now)
+        _hits[request.client.host] = [t for t in _hits[request.client.host] if now - t < 60]
+        if len(_hits[request.client.host]) > RATE_LIMIT:
+            raise HTTPException(429, "Too many authentication attempts, retry later")
+    return await call_next(request)
