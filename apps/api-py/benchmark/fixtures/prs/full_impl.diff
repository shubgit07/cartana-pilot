--- /dev/null
+++ b/app/services/tasks.py
@@ -0,0 +1,31 @@
+class TaskService:
+    _tasks: list[dict] = []
+    _seq: int = 0
+
+    @classmethod
+    def create(cls, title: str, description: str = "") -> dict:
+        cls._seq += 1
+        task = {"id": cls._seq, "title": title, "description": description}
+        cls._tasks.append(task)
+        return task
+
+    @classmethod
+    def list_all(cls) -> list[dict]:
+        return list(cls._tasks)
+
+    @classmethod
+    def update(cls, task_id: int, title: str, description: str) -> dict | None:
+        for task in cls._tasks:
+            if task["id"] == task_id:
+                task["title"] = title
+                task["description"] = description
+                return task
+        return None
+
+    @classmethod
+    def delete(cls, task_id: int) -> bool:
+        for i, task in enumerate(cls._tasks):
+            if task["id"] == task_id:
+                cls._tasks.pop(i)
+                return True
+        return False
