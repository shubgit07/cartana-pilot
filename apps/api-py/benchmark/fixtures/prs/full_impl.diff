+class AssignmentService:
+    _assignments: list[dict] = []
+
+    @classmethod
+    def assign(cls, task_id: str, user_id: str) -> dict:
+        assignment = {"task_id": task_id, "assignee_id": user_id, "status": "todo"}
+        cls._assignments.append(assignment)
+        return assignment
+
+    @classmethod
+    def set_status(cls, task_id: str, status: str) -> dict | None:
+        for assignment in cls._assignments:
+            if assignment["task_id"] == task_id:
+                assignment["status"] = status
+                return assignment
+        return None
