@@ -0,0 +1,13 @@
+from app.routes.assignments import assign_task, set_status
+from app.services.notifications import deliver_assignment_alert
+
+
+def test_assign_task():
+    result = assign_task("t1", "u2")
+    assert result["assignment"]["assignee_id"] == "u2"
+
+
+def test_set_status_valid_values():
+    assert set_status("t1", "in_progress")["status"] == "in_progress"
+
+
+def test_self_assignment_skips_notification():
+    assert deliver_assignment_alert("t1", "u1", "u1") is None
