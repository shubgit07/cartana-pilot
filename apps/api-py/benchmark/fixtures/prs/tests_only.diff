diff --git a/tests/test_auth.py b/tests/test_auth.py
new file mode 100644
index 0000000..7777777
--- /dev/null
+++ b/tests/test_auth.py
@@ -0,0 +1,24 @@
+from app.routes.auth import register, login, logout
+
+
+def test_register_creates_user():
+    result = register("a@example.com", "s3cret")
+    assert result["user_id"]
+
+
+def test_login_returns_session_token():
+    result = login("a@example.com", "s3cret")
+    assert result["session_token"]
+
+
+def test_logout_revokes_token():
+    token = login("a@example.com", "s3cret")["session_token"]
+    assert logout(token)["status"] == "ok"
+
+
+def test_login_rejects_wrong_password():
+    try:
+        login("a@example.com", "wrong")
+    except Exception:
+        pass
+    else:
+        raise AssertionError("expected login to fail")
diff --git a/tests/test_tasks.py b/tests/test_tasks.py
new file mode 100644
index 0000000..8888888
--- /dev/null
+++ b/tests/test_tasks.py
@@ -0,0 +1,15 @@
+from app.routes.tasks import create_task, delete_task, list_tasks, update_task
+
+
+def test_create_and_list_task():
+    created = create_task("Ship v2.1")["task"]
+    assert created["id"] in list_tasks()["tasks"]
+
+
+def test_update_task():
+    task = create_task("Ship v2.1")["task"]
+    updated = update_task(task["id"], "Ship v2.1 with notes", "More detail")
+    assert updated["title"] == "Ship v2.1 with notes"
+
+
+def test_delete_task():
+    task = create_task("Temp")["task"]
+    assert delete_task(task["id"])["status"] == "ok"
