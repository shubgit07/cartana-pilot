# Copy the root .env (or this file) to apps/api-py/.env
# Values below intentionally mirror the root .env.example so both the
# Node API and the Python API can point at the same infra during migration.

NODE_ENV=development
LOG_LEVEL=info

API_PORT=4000
API_BASE_URL=http://localhost:4000

# Postgres (SQLAlchemy accepts the same postgresql:// URL; config.py
# rewrites it to postgresql+psycopg:// internally)
DATABASE_URL=postgresql://cartana:cartana@localhost:5432/cartana?schema=public

REDIS_URL=redis://localhost:6379

STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage

EMBEDDING_PROVIDER=stub
EMBEDDING_MODEL=@cf/baai/bge-base-en-v1.5
EMBEDDING_DIM=768
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

LLM_PROVIDER=stub
LLM_MODEL=stub
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CLOUDFLARE_LLM_MODEL=@cf/meta/llama-3.1-8b-instruct

FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p1-8b-instruct

DEV_USER_ID=dev-user
DEV_USER_EMAIL=dev@cartana.local
DEV_USER_NAME=Local Dev
