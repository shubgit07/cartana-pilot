# ==========================================================================
# Cartana API — copy this file to apps/api-py/.env and fill the <...> values.
# Local runs (API, worker, benchmark) read ONLY this file. Never commit it.
# ==========================================================================

# ----- App -----
NODE_ENV=development
LOG_LEVEL=info
API_PORT=4000
API_BASE_URL=http://localhost:4000

# ----- Database (Neon Postgres) -----
# Neon dashboard → Connect → pooled URL (hostname contains "-pooler").
# Keep ?sslmode=require. Local fallback (commented): docker-compose Postgres.
DATABASE_URL=postgresql://<user>:<password>@<ep-xxxx-pooler>.<region>.aws.neon.tech/<dbname>?sslmode=require
# DATABASE_URL=postgresql://cartana:cartana@localhost:5432/cartana

# ----- Redis (Upstash TCP — workers + embedding cache) -----
# Upstash console → Redis DB → TCP endpoint. Must be rediss:// (TLS), NOT the REST URL.
# Local fallback (commented): REDIS_URL=redis://localhost:6379
REDIS_URL=rediss://default:<token>@<host>:6379

# ----- Upstash REST (24h PR-audit deduplication cache) -----
# Same Upstash DB → REST tab. Optional but recommended; without it, re-audits cost LLM tokens.
UPSTASH_REDIS_REST_URL=https://<name>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<token>

# ----- Storage -----
# Render test: local is ephemeral (re-upload after restarts) — fine for now.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage

# ----- Embeddings (Cloudflare Workers AI, BGE-base 768-dim) -----
EMBEDDING_PROVIDER=cloudflare
EMBEDDING_MODEL=@cf/baai/bge-base-en-v1.5
EMBEDDING_DIM=768
CLOUDFLARE_ACCOUNT_ID=<account-id>
CLOUDFLARE_API_TOKEN=<api-token>

# ----- Vector index (Qdrant Cloud — primary semantic retrieval) -----
# Qdrant Cloud → cluster overview. Collection is auto-created on first sync.
QDRANT_URL=https://<cluster-id>.<region>.cloud.qdrant.io
QDRANT_API_KEY=<key>
QDRANT_COLLECTION_NAME=cartana_chunks

# ----- GitHub (public-repo Codebase Index; no scopes needed for public data) -----
GITHUB_TOKEN=<token>

# ----- LLM (routing chain: cerebras → gemini → groq → stub) -----
# Any 2 keys minimum. Missing keys are skipped automatically, not errors.
LLM_PROVIDER=routing
LLM_MODEL=stub
GEMINI_API_KEY=<key>
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_AUDIT_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=<key>
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_EXTRACT_MODEL=llama-3.1-8b-instant
GROQ_AUDIT_MODEL=llama-3.3-70b-versatile
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.1-8b
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CLOUDFLARE_LLM_MODEL=@cf/meta/llama-3.1-8b-instruct
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p1-8b-instruct

# ----- Cost/compute budgets -----
EXTRACT_MAX_CHARS=80000
CHAT_HISTORY_MAX_MESSAGES=12
EMBED_CONCURRENCY=8
INGEST_TIMEOUT_SECONDS=600

# ----- Dev user (single-user local MVP, no auth) -----
DEV_USER_ID=dev-user
DEV_USER_EMAIL=dev@cartana.local
DEV_USER_NAME=Local Dev
