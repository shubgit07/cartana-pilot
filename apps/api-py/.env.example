# Copy the root .env (or this file) to apps/api-py/.env
# Values below intentionally mirror the root .env.example so both the
# Node API and the Python API can point at the same infra during migration.

NODE_ENV=development
LOG_LEVEL=info

API_PORT=4000
API_BASE_URL=http://localhost:4000

# Postgres (SQLAlchemy accepts the same postgresql:// URL; config.py
# rewrites it to postgresql+psycopg:// internally)
# NOTE: do NOT append ?schema=... — that is Prisma-only and psycopg rejects it.
DATABASE_URL=postgresql://cartana:cartana@localhost:5432/cartana

REDIS_URL=redis://localhost:6379

STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage

EMBEDDING_PROVIDER=cloudflare
EMBEDDING_MODEL=@cf/baai/bge-base-en-v1.5
EMBEDDING_DIM=768
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

LLM_PROVIDER=routing
LLM_MODEL=stub
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Groq — chat uses the chat model; extraction/audit use Groq as fallback
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_EXTRACT_MODEL=llama-3.1-8b-instant
GROQ_AUDIT_MODEL=llama-3.3-70b-versatile

# Gemini — structured pipeline (extraction/audit) + chat fallback
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash
# Audit coverage judgments use a cheaper/faster model (B2 coverage audit)
GEMINI_AUDIT_MODEL=gemini-3.5-flash-lite

# Cost/compute budgets
EXTRACT_MAX_CHARS=80000
CHAT_HISTORY_MAX_MESSAGES=12
EMBED_CONCURRENCY=8
# Overall deadline for the ingest pipeline; sources exceeding it are marked failed
INGEST_TIMEOUT_SECONDS=600

FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p1-8b-instruct

DEV_USER_ID=dev-user
DEV_USER_EMAIL=dev@cartana.local
DEV_USER_NAME=Local Dev
