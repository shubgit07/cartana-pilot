// Cartana - Prisma schema
//
// All core entities are defined up front (Phase 1 plan §5) so we don't pay
// for migration rewrites later. Some tables are unused in Phase 1 — that's
// intentional and called out per table.
//
// Single-user local MVP: every project-scoped table carries a `userId` so
// real auth can be added later without a data-model rewrite.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// =========================================================================
// User (Phase 1: implicit dev user; real auth is a later 🔴 scope change)
// =========================================================================

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects     Project[]
  sources      Source[]
  requirements Requirement[]
  tasks        Task[]
  coverageLinks CoverageLink[]
  auditRuns    AuditRun[]
}

// =========================================================================
// Project
// =========================================================================

model Project {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sources      Source[]
  requirements Requirement[]
  tasks        Task[]
  coverageLinks CoverageLink[]
  auditRuns    AuditRun[]

  @@index([userId])
  @@index([createdAt])
}

// =========================================================================
// Source (uploaded document / note)
// =========================================================================

enum SourceKind {
  pdf
  text
}

enum SourceStatus {
  uploaded
  processing
  processed
  failed
}

model Source {
  id           String       @id @default(cuid())
  projectId    String
  userId       String
  filename     String
  kind         SourceKind
  status       SourceStatus @default(uploaded)
  storageKey   String       // key/path inside the active StorageProvider
  mimeType     String?
  sizeBytes    Int?
  errorMessage String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks  Chunk[]

  @@index([projectId])
  @@index([userId])
  @@index([status])
}

// =========================================================================
// Chunk (a piece of a Source, with embedding for retrieval)
// =========================================================================
//
// EMBEDDING_DIM must stay in sync with packages/shared/src/constants.ts.
// Changing the embedding model later = a re-embed migration, not a free swap.

model Chunk {
  id        String                 @id @default(cuid())
  sourceId  String
  position  Int                    // ordinal position within source
  text      String
  // Vector(768) for Cloudflare @cf/baai/bge-base-en-v1.5.
  // Postgres `vector` type requires the pgvector extension.
  embedding Unsupported("vector(768)")?
  createdAt DateTime               @default(now())

  source          Source           @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  requirementChunks RequirementChunk[]
  taskChunks       TaskChunk[]

  @@index([sourceId])
  @@index([position])
}

// =========================================================================
// Requirement (Phase 2 - schema defined up front)
// =========================================================================

enum RequirementOrigin {
  ai
  user
}

enum RequirementState {
  suggested
  accepted
  rejected
  edited
}

model Requirement {
  id          String            @id @default(cuid())
  projectId   String
  userId      String
  title       String
  description String?
  origin      RequirementOrigin @default(ai)
  state       RequirementState  @default(suggested)
  /// Deterministic hash for idempotent re-extraction (sourceId + normalized title).
  /// Phase 2A: required so re-processing does not create duplicates.
  dedupeKey   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks        RequirementChunk[]
  tasks         Task[]            @relation("RequirementTasks")
  coverageLinks CoverageLink[]
  findings      AuditFinding[]

  @@index([projectId])
  @@index([userId])
  @@index([state])
  @@index([dedupeKey])
}

// M:N between Requirement and the Chunks it was derived from (traceability).
model RequirementChunk {
  requirementId String
  chunkId       String

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  chunk       Chunk       @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@id([requirementId, chunkId])
  @@index([chunkId])
}

// =========================================================================
// Task (Phase 2 - schema defined up front; manual create/edit/accept/reject/relink)
// =========================================================================

enum TaskOrigin {
  ai
  user
}

enum TaskState {
  suggested
  accepted
  rejected
  edited
}

model Task {
  id            String     @id @default(cuid())
  projectId     String
  userId        String
  // Optional primary requirement this task implements (links back to source of truth).
  requirementId String?
  title         String
  description   String?
  origin        TaskOrigin @default(ai)
  state         TaskState  @default(suggested)
  /// Deterministic hash for idempotent re-extraction (sourceId + normalized title).
  /// Phase 2B: required so re-processing does not create duplicates.
  dedupeKey     String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  requirement   Requirement?   @relation("RequirementTasks", fields: [requirementId], references: [id], onDelete: SetNull)
  chunks        TaskChunk[]
  coverageLinks CoverageLink[]
  findings      AuditFinding[]

  @@index([projectId])
  @@index([userId])
  @@index([requirementId])
  @@index([state])
  @@index([dedupeKey])
}

// M:N between Task and the Chunks it was derived from (traceability).
model TaskChunk {
  taskId  String
  chunkId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  chunk Chunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@id([taskId, chunkId])
  @@index([chunkId])
}

// =========================================================================
// CoverageLink (Phase 3 - schema defined up front)
// =========================================================================
//
// User-confirmed links (origin = user-confirmed) are treated as ground truth
// and must survive re-extraction. AI-suggested links can be replaced on
// re-extraction.

enum CoverageStatus {
  covered
  partial
  unclear
  missing
}

enum CoverageOrigin {
  ai_suggested
  user_confirmed
}

model CoverageLink {
  id            String         @id @default(cuid())
  projectId     String
  userId        String
  requirementId String
  taskId        String
  status        CoverageStatus
  origin        CoverageOrigin
  rationale     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  task        Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([requirementId, taskId])
  @@index([projectId])
  @@index([requirementId])
  @@index([taskId])
}

// =========================================================================
// AuditRun + AuditFinding (Phase 3 - schema defined up front)
// =========================================================================

enum AuditSeverity {
  info
  warning
  critical
}

enum AuditFindingKind {
  uncovered_requirement
  partial_coverage
  vague_requirement
  deadline_risk
  orphan_task
  other
}

model AuditRun {
  id            String   @id @default(cuid())
  projectId     String
  userId        String
  summary       String?
  createdAt     DateTime @default(now())

  project  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  findings AuditFinding[]

  @@index([projectId])
  @@index([createdAt])
}

model AuditFinding {
  id            String           @id @default(cuid())
  runId         String
  projectId     String
  kind          AuditFindingKind
  severity      AuditSeverity
  message       String
  requirementId String?
  taskId        String?
  createdAt     DateTime         @default(now())

  run         AuditRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  requirement Requirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  task        Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([runId])
  @@index([projectId])
  @@index([severity])
}